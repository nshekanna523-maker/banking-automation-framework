<suite name="Banking Automation Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.banking.listeners.TestListener"/>
    </listeners>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.banking.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.banking.tests.GoogleTest"/>
        </classes>
    </test>

</suite>